{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "TrimUrlApi",
    "Audience": "TrimUrl",
    "ExpiresInHours": 336
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5
    },
    "UrlCreation": {
      "PermitLimit": 20
    },
    "GeneralApi": {
      "PermitLimit": 100
    }
  }
}
